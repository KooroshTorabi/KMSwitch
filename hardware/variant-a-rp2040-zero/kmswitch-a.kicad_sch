        bold
      )
      (justify left bottom)
    )
    (uuid "e458de95-3b55-467c-b710-39cdefd7a59c")
  )
  (text "Adapter 5 V, 2-3 A. F1 protects the USB-A port. D1 feeds MCU-A so the keyboard works while PC 1 is off.\nNote: with PC 1 switched off and its cable plugged in, ~4.7 V reaches PC 1 VBUS through the module. Variant B avoids this."
    (at 20 34 0)
    (effects
      (font
        (size 1.5 1.5)
      )
      (justify left top)
    )
    (uuid "8b05149a-f852-4b20-978f-52d21701bd3b")
  )
